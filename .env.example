# ---------- Database (Supabase Postgres) ----------
# Pooled connection (port 6543) – used by the app on Vercel:
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session connection (port 5432):
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"

# ---------- Supabase Storage (videos, thumbnails, previews, ad images) ----------
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ... or sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="eyJ... or sb_secret_..."   # server only - never share

# ---------- Auth ----------
# Any random text, at least 32 characters
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# ---------- Paystack (token purchases) ----------
# Paystack Dashboard → Settings → API Keys & Webhooks. Use sk_test_ while testing, sk_live_ when live.
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."   # optional (checkout uses a Paystack-hosted page)
# Your live site address – Paystack sends buyers back here after paying
SITE_URL="https://videoske.vercel.app"

# ---------- Live streaming (LiveKit Cloud - https://cloud.livekit.io) ----------
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="API..."
LIVEKIT_API_SECRET="..."

# ---------- First admin (only for `npm run db:seed` on your computer) ----------
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
